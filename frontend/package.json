{
  "name": "strokelens",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check:i18n": "node ../scripts/check-i18n.mjs",
    "format": "prettier --write src vite.config.ts tsconfig.json package.json",
    "check:format": "prettier --check src vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.16",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.16",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
